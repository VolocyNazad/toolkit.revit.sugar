<Project Sdk="VolocyNazad.Revit.Sdk/1.1.0">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>
      Debug_2021.1.100;Debug_2022.1.80;Debug_2023.1.90;Debug_2024.3.60;Debug_2025.4.60;Debug_2026.4.10;Debug_2027.3.0;
      Release_2021.1.100;Release_2022.1.80;Release_2023.1.90;Release_2024.3.60;Release_2025.4.60;Release_2026.4.10;Release_2027.3.0
    </Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.TUnit.Revit" Version="$(MajorRevitVersion).*" />
    <!--
      TUnit's source generator emits a [ModuleInitializer]-attributed method in this assembly.
      System.Runtime.CompilerServices.ModuleInitializerAttribute only exists in the BCL from
      .NET 5 onward; the net48 configurations (Revit 2021-2024) need PolySharp's
      polyfill for it, or the build fails with CS0122. revit.linter avoids this per-project
      reference by making PolySharp a GlobalPackageReference in its (centrally managed)
      Directory.Packages.props - this repo has no central package management, so it's pinned
      here directly, on the one project that actually needs it.
    -->
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Revit.Sugar\Revit.Sugar.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Polyfill" Version="11.4.0" />
  </ItemGroup>
</Project>
