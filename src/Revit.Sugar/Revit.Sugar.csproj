<Project Sdk="VolocyNazad.Revit.Sdk/1.1.0">

	<PropertyGroup>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>VolocyNazad</Authors>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Copyright>Copyright © VolocyNazad</Copyright>
		<Description>Revit syntactic sugar: extension methods and small helpers for the Revit API.</Description>
		<PackageType>Dependency</PackageType>
		<PackageTags>autodesk;revit;api;extensions;sugar;</PackageTags>
		<PackageId>VolocyNazad.Revit.Sugar</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!--<PackageIcon>images\PackageIcon.png</PackageIcon>-->
		<PackageProjectUrl>https://github.com/VolocyNazad/toolkit.revit.sugar</PackageProjectUrl>
		<PackageOutputPath>..\..\artifacts\</PackageOutputPath>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/VolocyNazad/toolkit.revit.sugar</RepositoryUrl>
		<PackageReleaseNotes>https://github.com/VolocyNazad/toolkit.revit.sugar/blob/main/CHANGELOG.md</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<!--<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>-->
	</PropertyGroup>

	<ItemGroup>
		<!--<None Include="..\..\.nuget\PackageIcon.png" PackagePath="images/" Pack="true" Visible="false"/>-->
		<None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
	</ItemGroup>

	<PropertyGroup>
		<Configurations>
		  Debug_2021.1.100;Debug_2022.1.80;Debug_2023.1.90;Debug_2024.3.60;Debug_2025.4.60;Debug_2026.4.10;Debug_2027.3.0;
		  Release_2021.1.100;Release_2022.1.80;Release_2023.1.90;Release_2024.3.60;Release_2025.4.60;Release_2026.4.10;Release_2027.3.0
		</Configurations>
	</PropertyGroup>

	<!--
		MinVer computes minor.patch from git tags/commit history, major is always taken from MajorRevitVersion (set by the SDK from the configuration).
		If HEAD doesn't match a tag, MinVer increments patch itself and adds the suffix "dev.<number of commits after the tag>",
		e.g.: tag "0.0.6" + 4 commits after it -> patch=7, MinVerPreRelease="dev.4".
	-->
	<PropertyGroup>
		<MinVerTagPrefix></MinVerTagPrefix>
		<MinVerMinimumMajorMinor>0.0</MinVerMinimumMajorMinor>
		<MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
	</PropertyGroup>

	<Target Name="ApplyRevitVersion" AfterTargets="MinVer" BeforeTargets="GetAssemblyVersion;GenerateNuspec;CoreCompile">
		<PropertyGroup>
			<!-- AssemblyVersion/FileVersion — numbers only (System.Version doesn't support suffixes) -->
			<AssemblyVersion>$(MajorRevitVersion).0.$(MinVerPatch)</AssemblyVersion>
			<FileVersion>$(MajorRevitVersion).0.$(MinVerPatch)</FileVersion>

			<!-- Version/PackageVersion — with a "-dev.N" suffix if the build isn't from a tagged commit -->
			<Version Condition="'$(MinVerPreRelease)' == ''">$(MajorRevitVersion).0.$(MinVerPatch)</Version>
			<Version Condition="'$(MinVerPreRelease)' != ''">$(MajorRevitVersion).0.$(MinVerPatch)-$(MinVerPreRelease)</Version>
			<PackageVersion>$(Version)</PackageVersion>
		</PropertyGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(MajorRevitVersion).*" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(MajorRevitVersion).*" />
		<PackageReference Include="MinVer" Version="8.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
